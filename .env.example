PORT=3000                      # listening port (the host usually sets it)
NODE_ENV=development           # production on the host
DATABASE_URL=                  # PostgreSQL URL; empty means the local SQLite file is used
PG_CA_CERT=                    # the provider's CA certificate in PEM, newlines written as \n
DB_PATH=./data/sentinel.db     # local SQLite file (git-ignored)
VITE_CONTACT_EMAIL=            # optional: shown in the footer and on /contact when set
VITE_SOCIAL_LINKEDIN=          # optional: https URL; the footer link appears only when set
VITE_SOCIAL_FACEBOOK=          # optional
VITE_SOCIAL_INSTAGRAM=         # optional
