import { mkdtempSync, writeFileSync, mkdirSync } from 'node:fs';
import os from 'node:os';
import path from 'node:path';
import { createApp } from '../functions/app.js';

export function fakeRepo() {
  const contacts = new Map();
  const quotes = new Map();
  return {
    contacts,
    quotes,
    async init() {},
    async createContactMessage(m) { if (!contacts.has(m.requestId)) contacts.set(m.requestId, m); },
    async createQuoteRequest(q) { if (!quotes.has(q.requestId)) quotes.set(q.requestId, q); },
    async ping() {},
    async counts() { return { contact_messages: contacts.size, quote_requests: quotes.size }; },
    async close() {},
  };
}

export function tempDist() {
  const dir = mkdtempSync(path.join(os.tmpdir(), 'sentinel-dist-'));
  writeFileSync(path.join(dir, 'index.html'), '<!doctype html><div id="root"></div>');
  mkdirSync(path.join(dir, 'assets'));
  writeFileSync(path.join(dir, 'assets', 'app.js'), 'console.log(1)');
  return dir;
}

export async function startApp(overrides = {}) {
  const repo = overrides.repo ?? fakeRepo();
  const app = createApp({ repo, isDbReady: () => true, distDir: tempDist(), isProduction: true, ...overrides });
  const server = await new Promise((resolve) => { const s = app.listen(0, '127.0.0.1', () => resolve(s)); });
  const base = `http://127.0.0.1:${server.address().port}`;
  return { base, repo, close: () => new Promise((resolve) => server.close(resolve)) };
}

export const validContact = (over = {}) => ({
  requestId: crypto.randomUUID(), fullName: 'Болд Бат', email: 'Bold@Example.com', phone: '9007 0740',
  topic: 'general', message: 'Сайн байна уу', consent: true, locale: 'mn', website: '', ...over,
});
export const validQuote = (over = {}) => ({
  requestId: crypto.randomUUID(), fullName: 'Болд Бат', company: '', email: 'bold@example.com', phone: '+976 9007 0740',
  service: 'surveillance', siteType: 'warehouse', product: '', preferredContact: 'phone',
  details: '48 камер хэрэгтэй', consent: true, locale: 'mn', website: '', ...over,
});

export const post = (base, url, body, raw) =>
  fetch(base + url, { method: 'POST', headers: { 'content-type': 'application/json' }, body: raw ?? JSON.stringify(body) });
