import test from 'node:test';
import assert from 'node:assert/strict';
import { buildCells } from '../src/components/glass/engine/cutPattern.ts';

const area = (poly) => {
  let sum = 0;
  for (let i = 0; i < poly.length; i += 1) {
    const [x1, y1] = poly[i];
    const [x2, y2] = poly[(i + 1) % poly.length];
    sum += x1 * y2 - x2 * y1;
  }
  return Math.abs(sum) / 2;
};
const cross = (a, b, c) => (c[1] - a[1]) * (b[0] - a[0]) - (b[1] - a[1]) * (c[0] - a[0]);
const crosses = (a, b, c, d) => cross(a, c, d) * cross(b, c, d) < 0 && cross(a, b, c) * cross(a, b, d) < 0;
const isSimple = (poly) => {
  const n = poly.length;
  for (let i = 0; i < n; i += 1)
    for (let j = i + 1; j < n; j += 1) {
      if (j === i + 1 || (i === 0 && j === n - 1)) continue;
      if (crosses(poly[i], poly[(i + 1) % n], poly[j], poly[(j + 1) % n])) return false;
    }
  return true;
};

test('the five cells always tile the unit square, stay simple and stay inside it', () => {
  const pointers = [null, [0, 0], [1, 0], [0, 1], [1, 1], [0.5, 0.5]];
  for (const portrait of [false, true])
    for (let t = 0; t <= 60; t += 1.7)
      for (const pointer of pointers) {
        const cells = buildCells(t, pointer, portrait);
        let total = 0;
        for (const name of 'ABCDE') {
          const poly = cells[name];
          assert.ok(area(poly) > 1e-4, `${name} has area at t=${t}`);
          assert.ok(isSimple(poly), `${name} is simple at t=${t}`);
          for (const [x, y] of poly) assert.ok(x >= 0 && x <= 1 && y >= 0 && y <= 1, `${name} vertex inside at t=${t}`);
          total += area(poly);
        }
        assert.ok(Math.abs(total - 1) < 1e-9, `areas add up at t=${t}`);
      }
